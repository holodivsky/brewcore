@Metadata.layer: #CORE
@UI.headerInfo: {
  typeName: 'Price Condition',
  typeNamePlural: 'Price Conditions',
  title: { type: #STANDARD, value: 'MaterialName' },
  description: { type: #STANDARD, value: 'ConditionType' }
}
@UI.presentationVariant: [{ sortOrder: [{ by: 'Material', direction: #ASC }, { by: 'ValidFrom', direction: #DESC }] }]
annotate entity ZVHB_C_PriceCondition with
{
  @UI.facet: [
    { id: 'General', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'Condition', position: 10 },
    { id: 'Scales',  purpose: #STANDARD, type: #LINEITEM_REFERENCE, label: 'Quantity Discounts', position: 20, targetElement: '_Scale' },
    { id: 'Admin',   purpose: #STANDARD, type: #FIELDGROUP_REFERENCE, label: 'Administrative Data', position: 30, targetQualifier: 'Admin' }
  ]
  @UI.hidden: true
  PriceUUID;

  @UI.lineItem: [{ position: 10, importance: #HIGH }]
  @UI.identification: [{ position: 10 }]
  @UI.selectionField: [{ position: 10 }]
  @UI.textArrangement: #TEXT_FIRST
  ConditionType;

  @UI.hidden: true
  ConditionTypeName;

  @UI.lineItem: [{ position: 20, importance: #HIGH }]
  @UI.identification: [{ position: 20 }]
  @UI.selectionField: [{ position: 20 }]
  @UI.textArrangement: #TEXT_FIRST
  Material;

  @UI.hidden: true
  MaterialName;

  @UI.lineItem: [{ position: 30, importance: #HIGH }]
  @UI.identification: [{ position: 30 }]
  @UI.selectionField: [{ position: 30 }]
  @UI.textArrangement: #TEXT_FIRST
  DistributionChannel;

  @UI.hidden: true
  DistributionChannelName;

  @UI.lineItem: [{ position: 40, importance: #HIGH }]
  @UI.identification: [{ position: 40 }]
  ValidFrom;

  @UI.lineItem: [{ position: 50, importance: #HIGH }]
  @UI.identification: [{ position: 50 }]
  ValidTo;

  @UI.lineItem: [{ position: 60, importance: #HIGH }]
  @UI.identification: [{ position: 60 }]
  Amount;

  @UI.identification: [{ position: 70 }]
  Currency;

  @UI.lineItem: [{ position: 70, importance: #MEDIUM }]
  @UI.identification: [{ position: 80 }]
  BaseUnit;

  @UI.fieldGroup: [{ qualifier: 'Admin', position: 10 }]
  CreatedBy;

  @UI.fieldGroup: [{ qualifier: 'Admin', position: 20 }]
  CreatedAt;

  @UI.fieldGroup: [{ qualifier: 'Admin', position: 30 }]
  LastChangedBy;

  @UI.fieldGroup: [{ qualifier: 'Admin', position: 40 }]
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
}