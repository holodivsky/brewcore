projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZVHB_C_PriceCondition alias Price
{
  use create;
  use update;
  use delete;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Scale { create; with draft; }
}

define behavior for ZVHB_C_PriceConditionScale alias Scale
{
  use update;
  use delete;

  use association _Price { with draft; }
}