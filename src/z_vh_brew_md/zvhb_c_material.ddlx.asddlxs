annotate entity ZVHB_C_Material with
{
  @UI.facet: [
    { id: 'General',   purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'General Information', position: 10 },
    { id: 'Texts',     purpose: #STANDARD, type: #LINEITEM_REFERENCE, label: 'Descriptions', position: 20, targetElement: '_Text' },
    { id: 'Units',     purpose: #STANDARD, type: #LINEITEM_REFERENCE, label: 'Alternative Units of Measure', position: 30, targetElement: '_Unit' },
    { id: 'Plants',    purpose: #STANDARD, type: #LINEITEM_REFERENCE, label: 'Plant Data', position: 40, targetElement: '_Plant' },
    { id: 'Admin',     purpose: #STANDARD, type: #FIELDGROUP_REFERENCE, label: 'Administrative Data', position: 50, targetQualifier: 'Admin' }
  ]
  @UI.lineItem: [
    { position: 10, importance: #HIGH },
    { type: #FOR_ACTION, dataAction: 'reactivate', label: 'Reactivate' },
    { type: #FOR_ACTION, dataAction: 'deactivate', label: 'Deactivate' }
  ]
  @UI.identification: [
    { position: 10 },
    { type: #FOR_ACTION, dataAction: 'reactivate', label: 'Reactivate' },
    { type: #FOR_ACTION, dataAction: 'deactivate', label: 'Deactivate' }
  ]
  @UI.selectionField: [{ position: 10 }]
