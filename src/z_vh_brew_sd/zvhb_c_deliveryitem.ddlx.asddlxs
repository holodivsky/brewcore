@Metadata.layer: #CORE
@UI.headerInfo: {
  typeName: 'Delivery Item',
  typeNamePlural: 'Delivery Items',
  title: { type: #STANDARD, value: 'Item' },
  description: { type: #STANDARD, value: 'MaterialName' }
}
@UI.presentationVariant: [{ sortOrder: [{ by: 'Item', direction: #ASC }] }]
annotate entity ZVHB_C_DeliveryItem with
{
  @UI.facet: [
    { id: 'Item', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'Item', position: 10 }
  ]
  @UI.hidden: true
  DeliveryUUID;

  @UI.hidden: true
  ItemUUID;

  @UI.lineItem: [{ position: 10, importance: #HIGH }]
  @UI.identification: [{ position: 10 }]
  Item;

  @UI.lineItem: [{ position: 20, importance: #MEDIUM }]
  @UI.identification: [{ position: 20 }]
  OrderItem;

  @UI.hidden: true
  ItemCategory;

  @UI.lineItem: [{ position: 30, importance: #HIGH }]
  @UI.identification: [{ position: 30 }]
  @UI.textArrangement: #TEXT_FIRST
  Material;

  @UI.hidden: true
  MaterialName;

  @UI.lineItem: [{ position: 40, importance: #HIGH }]
  @UI.identification: [{ position: 40 }]
  Batch;

  @UI.lineItem: [{ position: 50, importance: #HIGH }]
  @UI.identification: [{ position: 50 }]
  ExpiryDate;

  @UI.lineItem: [{ position: 60, importance: #HIGH }]
  @UI.identification: [{ position: 60 }]
  Quantity;

  @UI.hidden: true
  Unit;

  @UI.lineItem: [{ position: 70, importance: #MEDIUM }]
  @UI.identification: [{ position: 70 }]
  StorageLocation;

  @UI.identification: [{ position: 80 }]
  Plant;

  @UI.hidden: true
  LocalLastChangedAt;
}