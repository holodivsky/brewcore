@Metadata.layer: #CORE
@UI.headerInfo: {
  typeName: 'Beer Tax Rate',
  typeNamePlural: 'Beer Tax Rates',
  title: { type: #STANDARD, value: 'PlantName' },
  description: { type: #STANDARD, value: 'ValidFrom' }
}
@UI.presentationVariant: [{ sortOrder: [{ by: 'Plant', direction: #ASC }, { by: 'ValidFrom', direction: #DESC }] }]
annotate entity ZVHB_C_BeerTaxRate with
{
  @UI.facet: [
    { id: 'General', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'Rate', position: 10 },
    { id: 'Admin',   purpose: #STANDARD, type: #FIELDGROUP_REFERENCE, label: 'Administrative Data', position: 20, targetQualifier: 'Admin' }
  ]
  @UI.hidden: true
  RateUUID;

  @UI.lineItem: [{ position: 10, importance: #HIGH }]
  @UI.identification: [{ position: 10 }]
  @UI.selectionField: [{ position: 10 }]
  @UI.textArrangement: #TEXT_FIRST
  Plant;

  @UI.hidden: true
  PlantName;

  @UI.lineItem: [{ position: 20, importance: #HIGH }]
  @UI.identification: [{ position: 20 }]
  ValidFrom;

  @UI.lineItem: [{ position: 30, importance: #HIGH }]
  @UI.identification: [{ position: 30 }]
  StandardRate;

  @UI.lineItem: [{ position: 40, importance: #HIGH }]
  @UI.identification: [{ position: 40 }]
  RatePercent;

  @UI.lineItem: [{ position: 50, importance: #HIGH }]
  @UI.identification: [{ position: 50 }]
  RatePerDegree;

  @UI.lineItem: [{ position: 60, importance: #MEDIUM }]
  @UI.identification: [{ position: 60 }]
  Currency;

  @UI.fieldGroup: [{ qualifier: 'Admin', position: 10 }]
  CreatedBy;

  @UI.fieldGroup: [{ qualifier: 'Admin', position: 20 }]
  CreatedAt;

  @UI.fieldGroup: [{ qualifier: 'Admin', position: 30 }]
  LastChangedBy;

  @UI.fieldGroup: [{ qualifier: 'Admin', position: 40 }]
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
}