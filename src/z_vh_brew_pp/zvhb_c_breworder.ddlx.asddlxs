@Metadata.layer: #CORE
@UI.headerInfo: {
  typeName: 'Brew Order',
  typeNamePlural: 'Brew Orders',
  title: { type: #STANDARD, value: 'BrewOrder' },
  description: { type: #STANDARD, value: 'MaterialName' }
}
@UI.presentationVariant: [{ sortOrder: [{ by: 'PlannedStart', direction: #DESC }] }]
annotate entity ZVHB_C_BrewOrder with
{
  @UI.facet: [
    { id: 'Status',     purpose: #HEADER,   type: #DATAPOINT_REFERENCE, targetQualifier: 'Status', position: 10 },
    { id: 'General',    purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'Brew', position: 10 },
    { id: 'Phases',     purpose: #STANDARD, type: #FIELDGROUP_REFERENCE, label: 'Phases', position: 20, targetQualifier: 'Phases' },
    { id: 'Components', purpose: #STANDARD, type: #LINEITEM_REFERENCE, label: 'Raw Materials', position: 30, targetElement: '_Component' },
    { id: 'Movements',  purpose: #STANDARD, type: #LINEITEM_REFERENCE, label: 'Goods Movements', position: 40, targetElement: '_Movement' },
    { id: 'Admin',      purpose: #STANDARD, type: #FIELDGROUP_REFERENCE, label: 'Administrative Data', position: 50, targetQualifier: 'Admin' }
  ]
  @UI.hidden: true
  BrewOrderUUID;

  @UI.lineItem: [
    { position: 10, importance: #HIGH },
    { type: #FOR_ACTION, dataAction: 'release', label: 'Release' },
    { type: #FOR_ACTION, dataAction: 'startMashing', label: 'Start Mashing' },
    { type: #FOR_ACTION, dataAction: 'startBoiling', label: 'Start Boiling' },
    { type: #FOR_ACTION, dataAction: 'startFermentation', label: 'Start Fermentation' },
    { type: #FOR_ACTION, dataAction: 'startMaturation', label: 'Start Maturation' },
    { type: #FOR_ACTION, dataAction: 'fill', label: 'Fill' }
  ]
  @UI.identification: [
    { position: 10 },
    { type: #FOR_ACTION, dataAction: 'release', label: 'Release' },
    { type: #FOR_ACTION, dataAction: 'startMashing', label: 'Start Mashing' },
    { type: #FOR_ACTION, dataAction: 'startBoiling', label: 'Start Boiling' },
    { type: #FOR_ACTION, dataAction: 'startFermentation', label: 'Start Fermentation' },
    { type: #FOR_ACTION, dataAction: 'startMaturation', label: 'Start Maturation' },
    { type: #FOR_ACTION, dataAction: 'fill', label: 'Fill' }
  ]
  @UI.selectionField: [{ position: 10 }]
  BrewOrder;

  @UI.lineItem: [{ position: 20, importance: #HIGH }]
  @UI.identification: [{ position: 20 }]
  @UI.selectionField: [{ position: 20 }]
  @UI.textArrangement: #TEXT_FIRST
  Material;

  @UI.hidden: true
  MaterialName;

  @UI.identification: [{ position: 30 }]
  RecipeVersion;

  @UI.lineItem: [{ position: 30, importance: #HIGH }]
  @UI.identification: [{ position: 40 }]
  PlannedQuantity;

  @UI.hidden: true
  Unit;

  @UI.lineItem: [{ position: 40, importance: #HIGH }]
  @UI.identification: [{ position: 50 }]
  @UI.selectionField: [{ position: 30 }]
  Tank;

  @UI.hidden: true
  TankDescription;

  @UI.lineItem: [{ position: 50, importance: #HIGH }]
  @UI.identification: [{ position: 60 }]
  PlannedStart;

  @UI.lineItem: [{ position: 60, importance: #MEDIUM }]
  @UI.identification: [{ position: 70 }]
  PlannedEnd;

  @UI.identification: [{ position: 80 }]
  FermentationDays;

  @UI.identification: [{ position: 90 }]
  MaturationDays;

  @UI.identification: [{ position: 100 }]
  Plant;

  @UI.lineItem: [{ position: 15, importance: #HIGH, criticality: 'StatusCriticality' }]
  @UI.dataPoint: { qualifier: 'Status', title: 'Status', criticality: 'StatusCriticality' }
  @UI.selectionField: [{ position: 40 }]
  @UI.textArrangement: #TEXT_ONLY
  Status;

  @UI.hidden: true
  StatusName;

  @UI.hidden: true
  StatusCriticality;

  @UI.fieldGroup: [{ qualifier: 'Phases', position: 10 }]
