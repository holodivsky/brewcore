  @UI.fieldGroup: [{ qualifier: 'Phases', position: 20 }]
  BoilingStart;

  @UI.fieldGroup: [{ qualifier: 'Phases', position: 30 }]
  FermentationStart;

  @UI.fieldGroup: [{ qualifier: 'Phases', position: 40 }]
  MaturationStart;

  @UI.fieldGroup: [{ qualifier: 'Phases', position: 50 }]
  FillingDate;

  @UI.fieldGroup: [{ qualifier: 'Phases', position: 60 }]
  FilledQuantity;

  @UI.lineItem: [{ position: 80, importance: #MEDIUM }]
  @UI.fieldGroup: [{ qualifier: 'Phases', position: 70 }]
  Batch;

  @UI.hidden: true
  RecipeUUID;

  @UI.hidden: true
  VersionUUID;

  @UI.fieldGroup: [{ qualifier: 'Admin', position: 10 }]
