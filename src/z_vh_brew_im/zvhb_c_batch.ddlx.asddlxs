@Metadata.layer: #CORE
@UI.headerInfo: {
  typeName: 'Batch',
  typeNamePlural: 'Batches',
  title: { type: #STANDARD, value: 'Batch' },
  description: { type: #STANDARD, value: 'MaterialName' }
}
@UI.presentationVariant: [{ sortOrder: [{ by: 'ExpiryDate', direction: #ASC }] }]
annotate entity ZVHB_C_Batch with
{
  @UI.facet: [
    { id: 'General', purpose: #STANDARD, type: #IDENTIFICATION_REFERENCE, label: 'General Information', position: 10 },
    { id: 'Admin',   purpose: #STANDARD, type: #FIELDGROUP_REFERENCE, label: 'Administrative Data', position: 20, targetQualifier: 'Admin' }
  ]
  @UI.lineItem: [{ position: 10, importance: #HIGH }]
  @UI.identification: [{ position: 10 }]
  @UI.selectionField: [{ position: 10 }]
  @UI.textArrangement: #TEXT_FIRST
  Material;

  @UI.lineItem: [
    { position: 20, importance: #HIGH },
    { type: #FOR_ACTION, dataAction: 'block', label: 'Block' },
    { type: #FOR_ACTION, dataAction: 'release', label: 'Release' }
  ]
  @UI.identification: [
    { position: 20 },
    { type: #FOR_ACTION, dataAction: 'block', label: 'Block' },
    { type: #FOR_ACTION, dataAction: 'release', label: 'Release' }
  ]
  @UI.selectionField: [{ position: 20 }]
  Batch;

  @UI.hidden: true
  MaterialName;

  @UI.lineItem: [{ position: 30, importance: #MEDIUM }]
  @UI.identification: [{ position: 30 }]
  ProductionDate;

  @UI.lineItem: [{ position: 40, importance: #HIGH }]
  @UI.identification: [{ position: 40 }]
  ExpiryDate;

  @UI.lineItem: [{ position: 50, importance: #HIGH }]
  @UI.identification: [{ position: 50 }]
  @UI.selectionField: [{ position: 30 }]
  @UI.textArrangement: #TEXT_ONLY
  Status;

  @UI.hidden: true
  StatusName;

  @UI.fieldGroup: [{ qualifier: 'Admin', position: 10 }]
  CreatedBy;

  @UI.fieldGroup: [{ qualifier: 'Admin', position: 20 }]
  CreatedAt;

  @UI.fieldGroup: [{ qualifier: 'Admin', position: 30 }]
  LastChangedBy;

  @UI.fieldGroup: [{ qualifier: 'Admin', position: 40 }]
  LastChangedAt;

  @UI.hidden: true
  LocalLastChangedAt;
}