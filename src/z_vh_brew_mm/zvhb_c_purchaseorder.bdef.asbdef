projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZVHB_C_PurchaseOrder alias PurchaseOrder
{
  use create;
  use update;
  use delete;

  use action createFromRequisition;
  use action order;
  use action approve;
  use action reject;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

  use association _Item { create; with draft; }
}

define behavior for ZVHB_C_PurchaseOrderItem alias Item
{
  use update;
  use delete;

  use action receiveGoods;

  use association _PurchaseOrder { with draft; }
}