@Metadata.layer: #CORE
@UI.headerInfo: {
  typeName: 'Item',
  typeNamePlural: 'Items',
  title: { type: #STANDARD, value: 'MaterialName' },
  description: { type: #STANDARD, value: 'Item' }
}
@UI.presentationVariant: [{ sortOrder: [{ by: 'Item', direction: #ASC }] }]
annotate entity ZVHB_C_SupplierInvoiceItem with
{
